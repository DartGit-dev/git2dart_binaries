+def validate_attestation(attestation: object, platform: str, versions: dict) -> list[str]:
+    if not isinstance(attestation, dict):
+        return ["invalid attestation"]
+
+    required = {"emitted_payload_sha256"}
+    if platform in {"macos", "ios"}:
+        required.update({"input_sha256", "emitted_sha256", "toolchain", "sdk", "compiled_metadata"})
+    if set(attestation) != required:
+        return ["invalid attestation fields"]
+
+    hashes = {"emitted_payload_sha256"}
+    if platform in {"macos", "ios"}:
+        hashes.update({"input_sha256", "emitted_sha256"})
+    errors = [f"invalid attestation {name}" for name in hashes
+              if not isinstance(attestation[name], str)
+              or not re.fullmatch(r"[0-9a-f]{64}", attestation[name])]
+    if platform in {"macos", "ios"}:
+        if not isinstance(attestation["toolchain"], str) or not attestation["toolchain"]:
+            errors.append("invalid attestation toolchain")
+        if not isinstance(attestation["sdk"], str) or not attestation["sdk"]:
+            errors.append("invalid attestation sdk")
+        if attestation["compiled_metadata"] != versions:
+            errors.append("invalid attestation compiled metadata")
+    return errors
