{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "platform", "abi", "openssl", "infeasibility_evidence", "approver", "review_by", "exact_parity"],
  "properties": {
    "id": {"type": "string", "pattern": "^EXC-[0-9]{4}-[0-9]{3}$"},
    "platform": {"type": "string", "minLength": 1},
    "abi": {"type": "string", "minLength": 1},
    "openssl": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "infeasibility_evidence": {"type": "string", "minLength": 1},
    "approver": {"type": "string", "minLength": 1},
    "review_by": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "exact_parity": {"const": "verified"}
  }
}
